DATABASE_URL=host=localhost user=postgres password=change_me dbname=knowledge_platform port=5432 sslmode=disable TimeZone=UTC

TEST_DATABASE_URL=host=localhost user=postgres password=change_me dbname=knowledge_platform_test port=5432 sslmode=disable TimeZone=UTC

TRAINING_TEST_DATABASE_URL=host=localhost user=postgres password=change_me dbname=knowledge_platform_test port=5432 sslmode=disable TimeZone=UTC

JWT_SECRET=replace-with-at-least-32-random-characters
HTTP_ADDRESS=:8080
HTTP_SHUTDOWN_TIMEOUT=15s
HTTP_SLOW_REQUEST_THRESHOLD=1s
# Empty means forwarded IP/proto/host headers are untrusted. List actual proxy IPs/CIDRs.
HTTP_TRUSTED_PROXIES=
# Set the exact public origin for a TLS-terminating tunnel that rewrites Host.
HTTP_PUBLIC_ORIGIN=
AUTH_LOGIN_LIMIT=10
AUTH_REGISTER_LIMIT=5
AUTH_REFRESH_LIMIT=60
AUTH_RATE_WINDOW=1m
AUTH_RATE_MAX_KEYS=10000
LOG_LEVEL=info
LOG_FORMAT=text
APP_VERSION=dev
ANALYTICS_ENABLED=false
CLICKHOUSE_ADDR=http://127.0.0.1:8123
CLICKHOUSE_DATABASE=knowledge_analytics
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
ANALYTICS_BUFFER_SIZE=4096
ANALYTICS_BATCH_SIZE=256
ANALYTICS_FLUSH_INTERVAL=5s
ANALYTICS_WRITE_TIMEOUT=5s
ANALYTICS_SHUTDOWN_TIMEOUT=10s
JWT_ISSUER=knowledge-platform
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# Optional Docker Compose overrides. Host Go settings above remain independent.
# These example credentials are for loopback-only local development.
# KP_ANALYTICS_ENABLED=true
# KP_BACKEND_PORT=8080
# KP_POSTGRES_PORT=55432
# KP_CLICKHOUSE_PORT=8123
# KP_PROMETHEUS_PORT=9090
# KP_GRAFANA_PORT=3000
# KP_POSTGRES_PASSWORD=local-postgres-only
# KP_JWT_SECRET=replace-with-at-least-32-random-characters
# KP_CLICKHOUSE_ADMIN_PASSWORD=local-clickhouse-admin-only
# KP_CLICKHOUSE_WRITER_PASSWORD=local-writer-only
# KP_CLICKHOUSE_READER_PASSWORD=local-reader-only
# KP_GRAFANA_USER=admin
# KP_GRAFANA_PASSWORD=local-grafana-only

# Optional local deployment helper settings
# LOCAL_VERSION=local-release-1
# LOCAL_READY_TIMEOUT=2m
